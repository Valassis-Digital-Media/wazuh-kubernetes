<group name="couponxchange">
    <!-- This rule detects a couponxchange log line. No alert is generated by this rule. -->
    <rule id="100150" level="0">
        <decoded_as>couponxchange</decoded_as>
        <field name="component" type="pcre2">de.valassis.util.listener.SessionListener</field>
        <description>CXC Alert</description>
    </rule>
    <!-- This rule detects a created session -->
    <rule id="100151" level="3">
        <if_sid>100150</if_sid>
        <field name="severity" type="pcre2">INFO</field>
        <field name="message" type="pcre2">Create session: .+</field>
        <description>A CXC session was created</description>
        <options>alert_by_email</options>
    </rule>
    <!-- This rule detects a destroyed session -->
    <rule id="100152" level="3">
        <if_sid>100150</if_sid>
        <field name="severity" type="pcre2">INFO</field>
        <field name="message" type="pcre2">Session destroyed: .+</field>
        <description>A CXC session was destroyed</description>
        <options>alert_by_email</options>
    </rule>
</group>
